# Copy to .env beside this file and fill in. .env is gitignored.
#
# These are the containers' own settings — what compose substitutes into
# compose.yml and compose.prod.yml. The api service's own settings live in
# services/api/.env (see services/api/.env.example); the deploy passes the few
# it needs through from here, so a deployed stack has no services/api/.env.

# --- database ------------------------------------------------------------
POSTGRES_USERNAME=invoicepilot_user
POSTGRES_PASSWORD=your_secure_password_here
# Loopback port Postgres is published on, for psql from the box. Not 5432: a
# machine usually has a local Postgres already, and clashing on the default is
# a confusing failure.
POSTGRES_LOCAL_PORT=57552

# --- public address (compose.prod.yml only) ----------------------------
# The origin share links are handed out under. Must be the public HTTPS
# address of the dashboard — a link opens the share page, which then calls
# /api/s/<token> back on the same origin. Baked into every link already sent,
# so changing it strands them.
PUBLIC_BASE_URL=https://invoicepilot.example.com

# Loopback port the dashboard is published on. Whatever terminates TLS for the
# hostname above proxies to it; see caddy-public.caddy.
WEB_LOCAL_PORT=8090

# --- unipile (compose.prod.yml only) -----------------------------------
# Empty is still a working deploy: the dashboard loads and share links work,
# and anything touching a mailbox answers 502 until these are set.
UNIPILE_API_KEY=
UNIPILE_DSN=
UNIPILE_NOTIFY_URL=

# --- teaching the scanner a new issuer (compose.prod.yml only) ---------
# Lets a scan draft a template for an issuer no template covers, once per
# sending domain. Optional: empty is a working deploy, and scanning behaves
# exactly as it did before — see services/api/.env.example.
# Either one; the key is resolved first. Do not set a variable to the empty
# string if you intend to use the other — an empty ANTHROPIC_API_KEY still wins
# the resolution order and shadows everything after it.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_AUTH_TOKEN=sk-ant-oat01-...

DEBUG_LOGS_ENABLED=false
