# The drafter's own settings. It needs no credentials of its own: it runs
# Claude Code, which reads the OAuth token mounted at $HOME/.claude/.credentials.json.

# Where it listens. compose.prod.yml keeps this off the network entirely — only
# the api service reaches it, by service name.
# PORT=8100
# HOST=0.0.0.0

# How long one draft may take. A few hundred tokens of output, but the model
# reasons first and the process has to start.
# DRAFT_TIMEOUT_MS=180000
