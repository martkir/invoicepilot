# Copy to .env beside this file and fill in. .env is gitignored.
#
# The api service's own settings, read by pydantic-settings when it runs on the
# host. The containers' settings are the repo-root .env; see ../../.env.example.
#
# Everything below the "NOT YET READ" divider is documentation of intent, not
# live config — those keys are ignored by services/api/src/invoicepilot/core/config.py today.

# ── DATABASE ─────────────────────────────────────────────────────────────────
POSTGRES_USERNAME=invoicepilot_user
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://invoicepilot_user:your_secure_password_here@localhost:57552/invoicepilot

# ── API SERVICE ──────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000

# Origin share links are handed out under: what POST /shares returns and what
# the button in a shared email points at. It is the public address of the
# dashboard, not of this API — a link opens the share page, which then calls
# /api/s/<token> back. Optional; the default is the Vite dev server, so a local
# run produces a link that opens.
PUBLIC_BASE_URL=http://localhost:5173

# ── GMAIL OAUTH (scripts/list_recent_subjects.py) ────────────────────────────
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID.
# The Gmail API must be enabled on the project, and while the consent screen is
# in "Testing" mode your own address must be listed under Test users.
GOOGLE_GMAIL_CLIENT_ID=your-gmail-client-id.apps.googleusercontent.com
GOOGLE_GMAIL_CLIENT_SECRET=your-gmail-client-secret

# Where Google sends the browser back after approval. Must byte-match a URI
# listed under the client's "Authorized redirect URIs" (exact string compare:
# http not https, no trailing slash, no path), and its port is the port the
# script binds locally. Loopback only. Optional — this is the default.
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:57553

# ── AURINKO (scripts/list_recent_subjects.py) ────────────────────────────────
# From the Aurinko portal -> your application. Aurinko brokers the provider
# OAuth, so no Google/Microsoft client is needed for this path.
AURINKO_CLIENT_ID=your-aurinko-client-id
AURINKO_CLIENT_SECRET=your-aurinko-client-secret

# Verifies inbound webhook signatures (X-Aurinko-Signature); unused by the
# script, unrelated to the OAuth exchange.
AURINKO_SIGNING_SECRET=your-aurinko-signing-secret

# Where Aurinko sends the browser back after approval. Must be listed under the
# app's "Authorized return URLs" in the portal, and its port is the port the
# script binds locally. Loopback only. Optional — this is the default.
AURINKO_RETURN_URL=http://localhost:57553

# ── UNIPILE (scripts/unipile_auth_link.py) ───────────────────────────────────
# From the Unipile dashboard. Like Aurinko, Unipile brokers the provider OAuth,
# so no Google/Microsoft client is needed unless you white-label the consent
# screen (dashboard -> Settings -> Google OAuth).
UNIPILE_API_KEY=your-unipile-api-key

# Your tenant's host:port, shown top-right in the dashboard. Host only — the
# script adds the https:// scheme and the /api/v1 path.
UNIPILE_DSN=apiXXX.unipile.com:XXXXX

# Public https URL Unipile POSTs {status, account_id, name} to when the user
# finishes the wizard. Must be reachable from the internet — a loopback URL
# will not work here. Optional; without it a connection succeeds silently.
UNIPILE_NOTIFY_URL=

# ── TEACHING THE SCANNER A NEW ISSUER ────────────────────────────────────────
# When a message looks like an invoice (see invoicepilot/gate.py) but no
# template recognises it, a scan asks Claude to draft one — once per sending
# domain, ever. Leave unset and scanning works exactly as before; an unknown
# issuer is simply reported instead of taught.
# Any credential the Anthropic SDK resolves works — a key here, an
# ANTHROPIC_AUTH_TOKEN, an `ant auth login` OAuth profile, or workload identity
# federation. Leave all of them unset and the feature is simply off. Do not set
# this to an empty string: it still wins the resolution order and shadows the
# others.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5

# ── DEBUG ────────────────────────────────────────────────────────────────────
DEBUG_LOGS_ENABLED=false


# ═════════════════════════════════════════════════════════════════════════════
# NOT YET READ — carried over from the removed Rust binary
# ═════════════════════════════════════════════════════════════════════════════
# Settings has no fields for these keys, so setting them does nothing right
# now — Drive upload and direct Gmail access are both unbuilt. Kept as a record
# of the behaviour the Python port still owes. See services/api/src/invoicepilot/process.py for what
# the scan does today.

# Drive upload destination (Account B).
# GOOGLE_DRIVE_CLIENT_ID=your-drive-client-id.apps.googleusercontent.com
# GOOGLE_DRIVE_CLIENT_SECRET=your-drive-client-secret
# GOOGLE_DRIVE_FOLDER_LOCATION=billing/all-expenses/2025

# Day of month for the scheduled fetch (1-31).
# FETCH_INVOICES_DAY=5

# Comma-separated keywords matched against subject/body when searching mail.
# TARGET_KEYWORDS_TO_FETCH_AND_DOWNLOAD="invoice, fatura, statement, bank, extrato, movimientos, fiscal, tributary"

# Completion summary sent via the Gmail API; sender is the authenticated account.
# SEND_NOTIFY_EMAIL=false
# NOTIFY_EMAIL=your-email@example.com

# Wise bank integration.
# WISE_API_KEY=your-wise-api-key
# WISE_PROFILE_ID=your-wise-profile-id
# WISE_PRIVATE_KEY_PATH=/path/to/private_pkcs8.pem
